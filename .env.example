# ── Telegram ──────────────────────────────────────────────────────────────
# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Who may use the bot at all — search, inline queries (empty = everyone)
ALLOWED_USER_IDS=123456789

# Who may START CAPTIONING (spends GPU time / API credits).
# Unset  -> inherits ALLOWED_USER_IDS
# Empty  -> nobody can index, the bot is search-only
INDEX_USER_IDS=123456789
# Hard cap on how many stickers one /index run may caption
MAX_PACK_SIZE=200
# Captions per user per UTC day, 0 = unlimited
DAILY_CAPTION_LIMIT=0

# ── Local vision model ────────────────────────────────────────────────────
# Providers: llamacpp | ollama | vllm | custom | none
VLM_PROVIDER=llamacpp
VLM_MODEL=qwen2.5-vl
# VLM_BASE_URL=http://host.docker.internal:8080/v1   # override the preset
# VLM_API_KEY=                                        # usually not needed
VLM_TIMEOUT=180

# ── Cloud vision model (optional) ─────────────────────────────────────────
# Providers: openai | anthropic | google | openrouter | groq | mistral | xai
# Leave CLOUD_PROVIDER empty to disable cloud captioning entirely.
CLOUD_PROVIDER=
CLOUD_API_KEY=
# CLOUD_MODEL=gpt-4o-mini          # override the provider's default model
# CLOUD_BASE_URL=                  # only for gateways / proxies
CLOUD_TIMEOUT=120

# Which backend captions stickers:
#   local — local endpoint only
#   cloud — cloud API only
#   auto  — local first, fall back to cloud when it is down (default if both set)
# Switch at runtime with /backend local|cloud|auto (INDEX_USER_IDS only)
CAPTION_BACKEND=auto

# ── Captioning & search ───────────────────────────────────────────────────
CAPTION_LANGUAGE=English
# Parallel captioning requests: ~2 for one local GPU, 6-10 for a cloud API
# CAPTION_CONCURRENCY=2
# Embeddings for semantic search.
#   api   — OpenAI-compatible /embeddings endpoint, no local RAM cost
#   local — sentence-transformers in-process (needs WITH_LOCAL_EMBEDDINGS=1 at
#           build time, ~2.5 GB RAM to build, ~700 MB resident)
#   none  — keyword-only search over the captions
#   auto  — local if it was built in, otherwise api, otherwise none
# EMBED_MODEL must match EMBED_PROVIDER: an API model name with
# EMBED_PROVIDER=local (or the reverse) will not work.
EMBED_PROVIDER=api
EMBED_MODEL=text-embedding-3-small
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=
# Mistral instead:
#   EMBED_MODEL=mistral-embed
#   EMBED_BASE_URL=https://api.mistral.ai/v1
# local model instead (needs WITH_LOCAL_EMBEDDINGS=1 at build time):
#   EMBED_PROVIDER=local
#   EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DB_PATH=/data/stickers.db
MAX_RESULTS=3
INLINE_RESULTS=30
# How bad a match may be before it is dropped, so a query nothing matches comes
# back empty instead of padded out to MAX_RESULTS.
#   SEARCH_MIN_SCORE         absolute cosine floor (default 0.20)
#   SEARCH_RELATIVE_CUTOFF   fraction of the best hit to keep (default 0.60)
# Raise for stricter results, lower if searches come back empty.
# SEARCH_MIN_SCORE=0.20
# SEARCH_RELATIVE_CUTOFF=0.60
